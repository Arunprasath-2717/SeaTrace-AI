# SeaTrace AI Environment Variables
# Single source of truth configuration

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=seatrace
POSTGRES_PASSWORD=seatrace_password
POSTGRES_DB=seatrace_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://seatrace:seatrace_password@localhost:5432/seatrace_db
ASYNC_DATABASE_URL=postgresql+asyncpg://seatrace:seatrace_password@localhost:5432/seatrace_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# File Storage
SEATRACE_DATA_DIR=./sea_trace/data
