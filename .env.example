# Ocean Trace M2 Backend Configuration

# Application
PROJECT_NAME="Ocean Trace M2 Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database (Default: SQLite, for Postgres: postgresql+psycopg2://user:password@localhost:5432/oceantrace)
DATABASE_URL="sqlite:///./ocean_trace.db"

# Security & Authentication
SECRET_KEY="ocean-trace-insecure-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Celery & Redis
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_TASK_ALWAYS_EAGER=True

# Scoring Configuration
SCORING_CONFIG_PATH="config/scoring.yaml"
