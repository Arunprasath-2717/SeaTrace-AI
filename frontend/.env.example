# SEATRACE Environment Variables Template
# Copy this file to .env for local development

# Base URL for SEATRACE backend API service
VITE_API_BASE_URL=http://localhost:8000

# MapLibre vector style URL or basemap tile specification
# Uses open basemap (e.g., CartoDB dark/positron, OpenFreeMap, or self-hosted vector tiles)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
